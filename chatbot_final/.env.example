# ============================================================
# Contoh Konfigurasi Environment RAG JAKEVO
# Salin file ini menjadi .env lalu isi API key Anda
# ============================================================

# Pilih penyedia LLM utama: gemini, deepseek, atau mimo
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# DeepSeek API (Opsional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Xiaomi MiMO API (Opsional)
MIMO_API_KEY=your_mimo_api_key_here
MIMO_MODEL=mimo-v1
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# Batas waktu satu panggilan LLM (detik)
LLM_TIMEOUT=60
